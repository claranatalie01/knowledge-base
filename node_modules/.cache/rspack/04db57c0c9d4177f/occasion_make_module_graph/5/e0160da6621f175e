 * @example
 *
 * ![](https://github.com/dagrejs/graphlib/wiki/images/components.png)
 *
 * ```js
 * graphlib.alg.components(g);
 * // => [ [ 'A', 'B', 'C', 'D' ],
 * //      [ 'E', 'F', 'G' ],
 * //      [ 'H', 'I' ] ]
 * ```
